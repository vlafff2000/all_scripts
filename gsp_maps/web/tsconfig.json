{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"], "react-dom/*": ["./node_modules/@types/react-dom/*"], "echarts": ["./node_modules/echarts"], "echarts/*": ["./node_modules/echarts/*"] }
  },
  "include": ["src", "vite.config.ts", "../../pxg_core/web-ui/*.tsx", "../../pxg_core/web-ui/chart/*.ts", "../../pxg_core/web-ui/chart/*.tsx"]
}
